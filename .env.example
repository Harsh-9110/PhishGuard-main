# Export these variables before starting Python. This app never loads .env implicitly.
# Local: omit DATABASE_URL to use instance/phishguard.db (SQLite).
# Vercel: set a ROTATED PostgreSQL connection string and a random secret in project settings.
# DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
RATE_LIMIT_PER_MINUTE="20"
# Comma-separated exact origins, e.g. chrome-extension://YOUR_EXTENSION_ID
ALLOWED_ORIGINS=""
